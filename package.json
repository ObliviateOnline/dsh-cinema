{
  "name": "dsh-cinema",
  "version": "1.3.0",
  "description": "DSH cinema plugin: left-sidebar TMDB poster wall plus CMS source management and in-panel playback",
  "license": "MIT",
  "author": "ObliviateOnline",
  "keywords": ["dsh", "dsh-plugin", "deepseek-harness", "tmdb", "movies", "cms"],
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md", "LICENSE", "vendor/*"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ObliviateOnline/dsh-cinema.git"
  },
  "homepage": "https://github.com/ObliviateOnline/dsh-cinema#readme",
  "bugs": {
    "url": "https://github.com/ObliviateOnline/dsh-cinema/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  }
}
